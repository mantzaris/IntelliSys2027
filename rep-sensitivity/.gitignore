# Local environments and Python caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/
*.egg-info/

# Bulk data and generated experiment artifacts
/data/
/artifacts/
/checkpoints/
/logs/
/outputs/
/runs/
/wandb/
/mlruns/
*.log
*.pt
*.pth
*.ckpt
*.safetensors

# Local credentials and secrets
.env
.env.*
!.env.example

# Editor and operating-system files
.DS_Store
*.swp
*.swo

# LaTeX intermediate files; the review PDF is intentionally retained
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz
/results/*-interim/
# Competence-only plots contain no repetition contrasts; regenerate on demand.
/results/competence-*/overview.pdf
/results/competence-*/overview.png
# Full held-out trial rows remain in the mirrored artifact package; curate aggregates.
/results/main-*/decisions.csv
/results/validation-*/decisions.csv
/results/validation-*/overview.png
# Vector figures are sufficient in Git; PNG previews are reproducible.
/results/*/figures/*.png
/results/main-*/overview.png
